<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="{Loc rnmc-toggles}"
    MinWidth="500">
    <GridContainer Columns="2">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <Control HorizontalExpand="True" SizeFlagsStretchRatio="1" />
            <Button Name="ToggleDefibs" Access="Public" Text="{Loc rnmc-defibs}" HorizontalExpand="True" SizeFlagsStretchRatio="2"/>
            <Button Name="Hardcore" Access="Public" Text="{Loc rnmc-hardcore}" HorizontalExpand="True" SizeFlagsStretchRatio="2"/>
            <Button Name="DropshipWeedkillers" Access="Public" Text="{Loc rnmc-dropship-weedkillers}" HorizontalExpand="True" SizeFlagsStretchRatio="2"/>
        </BoxContainer>
    </GridContainer>
</DefaultWindow>
